# Local Postgres-compatible database is used when DATABASE_URL is empty.
# A hosted Postgres database is required on Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
# Used only by npm run db:setup to provision the initial administrator.
ADMIN_EMAIL=
ADMIN_PASSWORD=
